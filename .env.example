# Copy this file to `.env` and fill in your keys. The app reads it on startup.
# Everything works WITHOUT any of these (the always-on `mock` provider covers
# you); add keys only when you want real live data.

# ─── eBay Browse API (current asking prices from active listings) ────────────
# Make a free app at https://developer.ebay.com/ -> "Application keys".
# Use the PRODUCTION App ID (Client ID) + Cert ID (Client Secret).
# The eBay provider auto-activates the moment both of these are present.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Which environment the keys above belong to: "production" or "sandbox".
# Sandbox keys (App ID contains "-SBX-") authenticate but return almost no real
# listings — use PRODUCTION keys for real lowest-listing prices.
EBAY_ENV=production

# Marketplace to search. eBay has NO dedicated NZ site, so EBAY_AU is the
# Oceania default. Other options: EBAY_US, EBAY_GB, EBAY_DE, ...
EBAY_MARKETPLACE_ID=EBAY_AU
